# 所有私有数据和运行文件保存在此目录；相对路径以启动目录为准。
NEWS_BRIEF_DATA_DIR=./data

# 正式生成简报需要一个支持工具调用的 OpenAI 兼容模型。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# 使用其他兼容供应商时填写，例如 https://your-provider.example/v1
OPENAI_BASE_URL=
NEWS_BRIEF_MODEL_TIMEOUT=90
NEWS_BRIEF_AGENT_TIMEOUT=240

# 使用 Resend 推送，未设置时仍可生成并在网页查看。
RESEND_API_KEY=
MAIL_FROM=

# 可选，用于访问远程新闻来源；不写入 JSON。显式代理使用代理端 DNS。
# Fake-IP/TUN 网络若将公网域名解析成 198.18.x.x，请填写实际的 HTTP 代理地址。
# 例如 http://127.0.0.1:7890（端口以自己的代理设置为准）
NEWS_BRIEF_HTTP_PROXY=

